# Only needed to point your copy at your own Firebase project; by default the
# app uses the demo project. Values come from Firebase console → Project
# settings → Your apps → Web app. They identify the project and are not secrets:
# access is controlled by database.rules.json.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_DOMAIN=test-data-747c4.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=test-data-747c4
# VITE_FIREBASE_DATABASE_URL=https://test-data-747c4-default-rtdb.firebaseio.com/
